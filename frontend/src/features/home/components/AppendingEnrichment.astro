---
import '../styles/appending-enrichment.css';

interface Props {
  data: any;
}

const { data } = Astro.props;
---

<div class="ae-split">

  <section
    class="ae-panel appending"
    data-screen-label="03 Appending"
  >
    <div class="ae-content">

      <div class="ae-header">
        <div class="ae-tag">
          {data?.appendingTag}
        </div>

        <h2 class="ae-title">
          {data?.appendingHeading}
          <em>{data?.appendingHighlight}</em>
        </h2>
      </div>

      <div class="ae-button-wrap">
        <a
          class="ae-btn"
          href={data?.appendingButtonLink || '/services/'}
        >
          {data?.appendingButtonText}
        </a>
      </div>

    </div>
  </section>


  <section
    class="ae-panel enrich"
    id="enrich"
    data-screen-label="04 Enrichment"
  >
    <div class="ae-content">

      <div class="ae-header">
        <div class="ae-tag">
          {data?.enrichmentTag}
        </div>

        <h2 class="ae-title">
          {data?.enrichmentHeading}
          <em>{data?.enrichmentHighlight}</em>
        </h2>
      </div>

      <div class="ae-button-wrap">
        <a
          class="ae-btn"
          href={data?.enrichmentButtonLink || '/enrichment/'}
        >
          {data?.enrichmentButtonText}
        </a>
      </div>

    </div>
  </section>

</div>