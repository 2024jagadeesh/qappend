---
import '../styles/intro.css';

interface Props {
  data: any;
}

const { data } = Astro.props;

const challenges = data?.challenges ?? [];
---

<section class="intro" data-screen-label="02 Intro">
  <div class="intro-grid">

    <!-- LEFT CONTENT -->
    <div>
      {data?.tag && (
        <div class="tag">
          {data.tag}
        </div>
      )}

      <h2
        class="h2"
        id="pain-heading"
        data-typewriter
      >
        {data.heading}

        {data.headingHighlight && (
          <>
            {' '}
            <em>{data.headingHighlight}</em>
          </>
        )}

        {data.headingEnd && (
          <>
            {' '}
            {data.headingEnd}
          </>
        )}
      </h2>

      {data?.description && (
        <p class="lede intro-description">
          {data.description}
        </p>
      )}

      {data?.buttonText && (
        <div class="intro-action">
          <a
            href={data?.buttonLink || '#'}
            class="btn btn-primary"
            data-open-modal
          >
            {data.buttonText}
          </a>
        </div>
      )}
    </div>

    <!-- RIGHT CONTENT -->
    <div class="intro-aside">

      {data?.symptomsLabel && (
        <div class="intro-symptoms">
          {data.symptomsLabel}
        </div>
      )}

      <div class="challenges">
        {challenges.map((challenge: any) => (
          <div
            class="challenge"
            style={`--ch: ${challenge.color || 'var(--hot)'}`}
          >
            <span class="num">
              {challenge.number}
            </span>

            <span class="name">
              {challenge.name}
            </span>

            {challenge.badge && (
              <span class="badge">
                {challenge.badge}
              </span>
            )}
          </div>
        ))}
      </div>

    </div>

  </div>
</section>


<script>
  const initTypewriter = () => {
    const el = document.querySelector('[data-typewriter]');

    if (!el || el.getAttribute('data-typewriter-initialized') === 'true') {
      return;
    }

    el.setAttribute('data-typewriter-initialized', 'true');

    // Capture text segments and preserve <em> styling
    const segs: { em: boolean; text: string }[] = [];

    el.childNodes.forEach((node) => {
      if (node.nodeType === 3) {
        segs.push({
          em: false,
          text: node.textContent || '',
        });
      } else if (
        node.nodeType === 1 &&
        (node as HTMLElement).tagName === 'EM'
      ) {
        segs.push({
          em: true,
          text: node.textContent || '',
        });
      }
    });

    // Rebuild heading character by character
    el.textContent = '';

    const chars: HTMLElement[] = [];

    segs.forEach((seg) => {
      const host = seg.em
        ? document.createElement('em')
        : el;

      if (seg.em) {
        el.appendChild(host);
      }

      for (const ch of seg.text) {
        const span = document.createElement('span');

        span.className = 'tw-char';
        span.textContent = ch;

        host.appendChild(span);
        chars.push(span);
      }
    });

    // Caret
    const caret = document.createElement('span');

    caret.className = 'tw-caret';

    el.insertBefore(caret, el.firstChild);

    let started = false;

    function run() {
      let i = 0;

      function step() {
        if (i < chars.length) {
          chars[i].classList.add('show');
          chars[i].after(caret);

          i++;

          setTimeout(step, 52);
        } else {
          caret.classList.add('tw-caret--done');
        }
      }

      step();
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !started) {
            started = true;
            run();
            observer.disconnect();
          }
        });
      },
      {
        threshold: 0.5,
      }
    );

    observer.observe(el);
  };

  initTypewriter();
</script>