---
import '../../styles/components/contact.css';
---

<section class="contact" data-screen-label="Contact">
  <div class="bk" id="bk">

    <!-- =========================================
         STEP 1: SCHEDULE
    ========================================== -->

    <div
      class="bk-step active"
      id="bk-step-1"
      data-screen-label="Contact · Schedule"
    >

      <div class="bk-sched">

        <!-- LEFT INFO -->

        <div class="bk-info">

          <div class="bk-host">

            <div class="bk-av">
              QA
            </div>

            <div>
              <div class="bk-host-name">
                QuickAppend Team
              </div>

              <div
                style="
                  font-size:13px;
                  color:color-mix(in srgb,#fbf8f0 78%,transparent);
                "
              >
                Data specialists
              </div>
            </div>

          </div>

          <h2>
            30-min discovery call
          </h2>

          <div class="bk-detail">

            <svg viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="9"/>
              <path d="M12 7v5l3 2"/>
            </svg>

            30 minutes

          </div>

          <div class="bk-detail">

            <svg viewBox="0 0 24 24">
              <rect
                x="3"
                y="6"
                width="13"
                height="12"
                rx="2"
              />
              <path d="M16 10l5-3v10l-5-3z"/>
            </svg>

            Zoom (link sent on confirmation)

          </div>

          <div class="bk-detail">

            <svg viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="9"/>
              <path d="M3 12h18"/>
              <path d="M12 3c2.5 2.5 2.5 15.5 0 18"/>
              <path d="M12 3c-2.5 2.5-2.5 15.5 0 18"/>
            </svg>

            EST - USA

          </div>

          <div class="bk-divider"></div>

          <p>
            We'll review your current data, spot what's incomplete
            or decayed, and map the appending and enrichment that
            would move your numbers. No prep needed.
          </p>

        </div>


        <!-- CALENDAR -->

        <div class="bk-cal">

          <div class="bk-cal-head">

            <h3 id="bk-month">
              Month
            </h3>

            <div class="bk-nav">

              <button
                type="button"
                id="bk-prev"
                aria-label="Previous month"
              >
                ‹
              </button>

              <button
                type="button"
                id="bk-next"
                aria-label="Next month"
              >
                ›
              </button>

            </div>

          </div>


          <div class="bk-dow">

            <span>Sun</span>
            <span>Mon</span>
            <span>Tue</span>
            <span>Wed</span>
            <span>Thu</span>
            <span>Fri</span>
            <span>Sat</span>

          </div>


          <div
            class="bk-grid"
            id="bk-grid"
          ></div>

        </div>


        <!-- TIME SLOTS -->

        <div class="bk-slots">

          <div class="bk-slots-head">
            Available times
          </div>

          <div
            class="bk-slots-day"
            id="bk-sel-day"
          >
            Select a date
          </div>

          <div
            class="bk-slots-list"
            id="bk-slots-list"
          >

            <div
              class="bk-note"
              id="bk-slots-empty"
            >
              Pick a weekday on the calendar to see open Zoom slots.
            </div>

          </div>

        </div>

      </div>


      <!-- STEP 1 CTA -->

      <div class="bk-cta-row">

        <div class="bk-tz">

          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9"/>
            <path d="M3 12h18"/>
            <path d="M12 3c2.5 2.5 2.5 15.5 0 18"/>
            <path d="M12 3c-2.5 2.5-2.5 15.5 0 18"/>
          </svg>

          Times shown in EST - USA

        </div>

        <button
          class="btn btn-hot"
          id="bk-continue"
          type="button"
          disabled
        >
          Continue to details
        </button>

      </div>

    </div>


    <!-- =========================================
         STEP 2: DETAILS
    ========================================== -->

    <div
      class="bk-step"
      id="bk-step-2"
      data-screen-label="Contact · Details"
    >

      <div class="bk-form-wrap">

        <!-- INFO -->

        <div class="bk-info">

          <div class="bk-host">

            <div class="bk-av">
              QA
            </div>

            <div>

              <div class="bk-host-name">
                QuickAppend Team
              </div>

              <div
                style="
                  font-size:13px;
                  color:color-mix(in srgb,#fbf8f0 78%,transparent);
                "
              >
                Data specialists
              </div>

            </div>

          </div>

          <h2>
            30-min discovery call
          </h2>

          <div class="bk-detail">

            <svg viewBox="0 0 24 24">
              <rect
                x="3"
                y="5"
                width="18"
                height="16"
                rx="2"
              />
              <path d="M3 9h18"/>
              <path d="M8 3v4"/>
              <path d="M16 3v4"/>
            </svg>

            <span id="bk-sum-date">—</span>

          </div>

          <div class="bk-detail">

            <svg viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="9"/>
              <path d="M12 7v5l3 2"/>
            </svg>

            <span id="bk-sum-time">—</span>
            · 30 min

          </div>

          <div class="bk-detail">

            <svg viewBox="0 0 24 24">
              <rect
                x="3"
                y="6"
                width="13"
                height="12"
                rx="2"
              />
              <path d="M16 10l5-3v10l-5-3z"/>
            </svg>

            Zoom (link sent on confirmation)

          </div>

          <div class="bk-divider"></div>

          <p>
            Almost there. Tell us where to send the invite
            and the best number to reach you on.
          </p>

        </div>


        <!-- FORM -->

        <form
          class="bk-form"
          id="bk-form"
        >

          <button
            type="button"
            class="bk-back"
            id="bk-back"
          >
            ← Change date &amp; time
          </button>

          <h3>
            Your details
          </h3>


          <!-- NAME -->

          <div class="bk-field">

            <label>
              Full name
              <span class="req">*</span>
            </label>

            <input
              type="text"
              id="bk-name"
              name="name"
              required
              placeholder="Alex Rivera"
            />

          </div>


          <!-- EMAIL + PHONE -->

          <div class="bk-row2">

            <div class="bk-field">

              <label>
                Work email
                <span class="req">*</span>
              </label>

              <input
                type="email"
                id="bk-email"
                name="email"
                required
                placeholder="you@company.com"
              />

            </div>


            <div class="bk-field">

              <label>
                Phone
                <span class="req">*</span>
              </label>

              <input
                type="tel"
                id="bk-phone"
                name="phone"
                required
                placeholder="+1 (555) 000-0000"
              />

            </div>

          </div>


          <!-- COMPANY -->

          <div class="bk-field">

            <label>
              Company
            </label>

            <input
              type="text"
              id="bk-company"
              name="company"
              placeholder="Acme Inc"
            />

          </div>


          <!-- MESSAGE -->

          <div class="bk-field">

            <label>
              What would you like to cover?
            </label>

            <textarea
              id="bk-message"
              name="message"
              rows="3"
              placeholder="Email bounces, missing direct dials, stale firmographics..."
            ></textarea>

          </div>


          <!-- SUBMIT -->

          <button
            type="submit"
            class="btn btn-hot"
            id="bk-submit"
            style="justify-content:center;margin-top:6px;"
          >
            Confirm Zoom call
          </button>

        </form>

      </div>

    </div>


    <!-- =========================================
         STEP 3: CONFIRMATION
    ========================================== -->

    <div
      class="bk-step"
      id="bk-step-3"
      data-screen-label="Contact · Confirmed"
    >

      <div class="bk-confirm">

        <div class="bk-check">
          ✓
        </div>

        <h3>
          Your Zoom call is booked.
        </h3>

        <div
          class="bk-summary-card"
          id="bk-confirm-when"
        >
          —
        </div>

        <p>
          A calendar invite with the Zoom link is on its way to
          <b id="bk-confirm-email">
            your inbox
          </b>.

          We'll reach out at
          <b id="bk-confirm-phone">
            your number
          </b>
          if we can't connect.
        </p>

        <div class="bk-confirm-actions">

          <a
            class="btn btn-primary"
            href="/"
          >
            Back to home
          </a>

          <button
            type="button"
            class="btn btn-ghost"
            id="bk-rebook"
          >
            Book another time
          </button>

        </div>

      </div>

    </div>

  </div>
</section>


<script>
  (() => {

    const $ = (id: string) =>
      document.getElementById(id) as HTMLElement;

    const MONTHS = [
      'January',
      'February',
      'March',
      'April',
      'May',
      'June',
      'July',
      'August',
      'September',
      'October',
      'November',
      'December',
    ];

    const WEEKDAYS = [
      'Sun',
      'Mon',
      'Tue',
      'Wed',
      'Thu',
      'Fri',
      'Sat',
    ];


    /*
     * Static available time slots
     *
     * These are the same slots from your original HTML.
     */
    const SLOTS = [
      '9:00 AM',
      '9:30 AM',
      '10:00 AM',
      '11:00 AM',
      '1:00 PM',
      '1:30 PM',
      '2:30 PM',
      '3:30 PM',
      '4:00 PM',
    ];


    const today = new Date();

    today.setHours(0, 0, 0, 0);


    /*
     * Allow booking for the next 3 months.
     */
    const minMonth = new Date(
      today.getFullYear(),
      today.getMonth(),
      1
    );

    const maxMonth = new Date(
      today.getFullYear(),
      today.getMonth() + 3,
      1
    );


    let view = new Date(minMonth);


    const state: {
      date: Date | null;
      time: string | null;
    } = {
      date: null,
      time: null,
    };


    const monthEl = $('bk-month');
    const grid = $('bk-grid');
    const prevBtn =
      $('bk-prev') as HTMLButtonElement;

    const nextBtn =
      $('bk-next') as HTMLButtonElement;

    const continueBtn =
      $('bk-continue') as HTMLButtonElement;

    const selDay =
      $('bk-sel-day');

    const slotsList =
      $('bk-slots-list');


    function formatDateKey(date: Date) {

      return [
        date.getFullYear(),
        String(date.getMonth() + 1).padStart(2, '0'),
        String(date.getDate()).padStart(2, '0'),
      ].join('-');

    }


    function isSameDay(
      a: Date,
      b: Date
    ) {

      return (
        a.getFullYear() === b.getFullYear() &&
        a.getMonth() === b.getMonth() &&
        a.getDate() === b.getDate()
      );

    }


    function available(date: Date) {

      const day =
        date.getDay();

      /*
       * Monday-Friday only.
       */
      if (day === 0 || day === 6) {
        return false;
      }


      /*
       * Do not allow dates before today.
       */
      if (date < today) {
        return false;
      }


      /*
       * Do not allow dates beyond max month.
       */
      if (date >= maxMonth) {
        return false;
      }


      return true;

    }


    function fmtShort(date: Date) {

      return (
        WEEKDAYS[date.getDay()] +
        ', ' +
        MONTHS[date.getMonth()].slice(0, 3) +
        ' ' +
        date.getDate()
      );

    }


    function fmtLong(date: Date) {

      return (
        WEEKDAYS[date.getDay()] +
        ', ' +
        MONTHS[date.getMonth()] +
        ' ' +
        date.getDate() +
        ', ' +
        date.getFullYear()
      );

    }


    function renderCal() {

      const year =
        view.getFullYear();

      const month =
        view.getMonth();


      monthEl.textContent =
        MONTHS[month] +
        ' ' +
        year;


      grid.innerHTML = '';


      /*
       * First day of month.
       */
      const firstDay =
        new Date(year, month, 1);


      /*
       * Number of days.
       */
      const daysInMonth =
        new Date(
          year,
          month + 1,
          0
        ).getDate();


      /*
       * Blank cells before first day.
       */
      for (
        let i = 0;
        i < firstDay.getDay();
        i++
      ) {

        const blank =
          document.createElement('div');

        blank.className =
          'bk-day blank';

        grid.appendChild(blank);

      }


      /*
       * Calendar days.
       */
      for (
        let day = 1;
        day <= daysInMonth;
        day++
      ) {

        const date =
          new Date(
            year,
            month,
            day
          );


        const button =
          document.createElement('button');

        button.type = 'button';

        button.className =
          'bk-day';

        button.textContent =
          String(day);


        if (
          state.date &&
          isSameDay(date, state.date)
        ) {

          button.classList.add(
            'selected'
          );

        }


        if (
          available(date)
        ) {

          button.addEventListener(
            'click',
            () => selectDate(date)
          );

        } else {

          button.disabled = true;

        }


        grid.appendChild(button);

      }


      /*
       * Month navigation.
       */
      prevBtn.disabled =
        view <= minMonth;

      nextBtn.disabled =
        view >= maxMonth;

    }


    function selectDate(
      date: Date
    ) {

      state.date =
        date;

      state.time =
        null;

      renderCal();

      renderSlots();

      updateContinue();

    }


    function renderSlots() {

      if (!state.date) {

        selDay.textContent =
          'Select a date';

        slotsList.innerHTML = `
          <div class="bk-note">
            Pick a weekday on the calendar
            to see open Zoom slots.
          </div>
        `;

        return;

      }


      selDay.textContent =
        fmtShort(state.date);


      slotsList.innerHTML = '';


      SLOTS.forEach(
        (time) => {

          const button =
            document.createElement('button');

          button.type = 'button';

          button.className =
            'bk-slot';

          button.textContent =
            time;


          button.addEventListener(
            'click',
            () => {

              state.time =
                time;


              Array
                .from(
                  slotsList.children
                )
                .forEach(
                  (child) => {
                    child.classList.remove(
                      'selected'
                    );
                  }
                );


              button.classList.add(
                'selected'
              );


              updateContinue();

            }
          );


          slotsList.appendChild(
            button
          );

        }
      );

    }


    function updateContinue() {

      continueBtn.disabled =
        !(
          state.date &&
          state.time
        );

    }


    function showStep(
      step: number
    ) {

      [1, 2, 3].forEach(
        (number) => {

          const element =
            $(`bk-step-${number}`);

          element.classList.toggle(
            'active',
            number === step
          );

        }
      );


      const booking =
        $('bk');


      const top =
        booking.getBoundingClientRect().top +
        window.scrollY -
        90;


      window.scrollTo({
        top,
        behavior: 'smooth',
      });

    }


    /*
     * Previous month.
     */
    prevBtn.addEventListener(
      'click',
      () => {

        if (view > minMonth) {

          view =
            new Date(
              view.getFullYear(),
              view.getMonth() - 1,
              1
            );

          renderCal();

        }

      }
    );


    /*
     * Next month.
     */
    nextBtn.addEventListener(
      'click',
      () => {

        if (view < maxMonth) {

          view =
            new Date(
              view.getFullYear(),
              view.getMonth() + 1,
              1
            );

          renderCal();

        }

      }
    );


    /*
     * Continue to details.
     */
    continueBtn.addEventListener(
      'click',
      () => {

        if (
          continueBtn.disabled ||
          !state.date ||
          !state.time
        ) {
          return;
        }


        $('bk-sum-date').textContent =
          fmtLong(state.date);


        $('bk-sum-time').textContent =
          state.time;


        showStep(2);

      }
    );


    /*
     * Back to calendar.
     */
    $('bk-back').addEventListener(
      'click',
      () => {
        showStep(1);
      }
    );


    /*
     * FORM SUBMISSION
     *
     * This is the important new part.
     *
     * We send the form data to:
     *
     * /api/contact-booking
     *
     * The API endpoint then sends the email
     * through Resend.
     */
    $('bk-form').addEventListener(
      'submit',
      async (event) => {

        event.preventDefault();


        if (
          !state.date ||
          !state.time
        ) {
          return;
        }


        const form =
          $('bk-form') as HTMLFormElement;


        const submitButton =
          $('bk-submit') as HTMLButtonElement;


        const name =
          (
            $('bk-name') as HTMLInputElement
          ).value.trim();


        const email =
          (
            $('bk-email') as HTMLInputElement
          ).value.trim();


        const phone =
          (
            $('bk-phone') as HTMLInputElement
          ).value.trim();


        const company =
          (
            $('bk-company') as HTMLInputElement
          ).value.trim();


        const message =
          (
            $('bk-message') as HTMLTextAreaElement
          ).value.trim();


        submitButton.disabled =
          true;

        submitButton.textContent =
          'Sending...';


        const payload = {

          name,

          email,

          phone,

          company,

          message,

          date:
            fmtLong(state.date),

          time:
            state.time,

        };


        try {

          const response =
            await fetch(
              '/api/contact-booking',
              {
                method: 'POST',

                headers: {
                  'Content-Type':
                    'application/json',
                },

                body:
                  JSON.stringify(payload),
              }
            );


          const result =
            await response.json();


          if (
            !response.ok ||
            !result.success
          ) {

            throw new Error(
              result.message ||
              'Unable to send booking.'
            );

          }


          /*
           * Email sent successfully.
           */

          $('bk-confirm-when')
            .textContent =
              `${fmtLong(state.date)} · ${state.time} ET`;


          $('bk-confirm-email')
            .textContent =
              email || 'your inbox';


          $('bk-confirm-phone')
            .textContent =
              phone || 'your number';


          showStep(3);

        } catch (error) {

          console.error(
            'Booking error:',
            error
          );


          alert(
            'We could not complete your booking. Please try again.'
          );

        } finally {

          submitButton.disabled =
            false;

          submitButton.textContent =
            'Confirm Zoom call';

        }

      }
    );


    /*
     * Book another time.
     */
    $('bk-rebook').addEventListener(
      'click',
      () => {

        state.date =
          null;

        state.time =
          null;


        const form =
          $('bk-form') as HTMLFormElement;

        form.reset();


        renderCal();

        renderSlots();

        updateContinue();

        showStep(1);

      }
    );


    /*
     * Initial render.
     */
    renderCal();

    renderSlots();

    updateContinue();

  })();
</script>