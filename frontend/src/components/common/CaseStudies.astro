---
import '../../styles/components/case-studies.css';

const { data } = Astro.props;

const caseStudies = data?.relatedCaseStudies || [];
---

<section
  class="cases"
  data-screen-label="10 Cases"
>
  <div class="cases-hd">
    <div>
      <div class="tag">{data?.tag}</div>

      <h2 class="h2">
        {data?.heading}
        <em>{data?.headingHighlight}</em>.
      </h2>
    </div>

    <p class="lede">
      {data?.description}
    </p>
  </div>

  <div class="cs-grid">
    {caseStudies.map((item: any) => {
      const metric = item?.metrics?.[0];

      return (
        <div class="cs">

          <div class="cs-stat">
            {metric?.value}

            {metric?.label && (
              <em>{metric.label}</em>
            )}
          </div>

          <h4>{item?.title}</h4>

          <p>{item?.subtitle}</p>

        </div>
      );
    })}
  </div>

  <div style="text-align: center;">
    <a
      class="btn btn-hot"
      href={data?.buttonLink || '/case-studies/'}
    >
      {data?.buttonText || 'Read full case studies'}
    </a>
  </div>
</section>