---
import '../../styles/components/services-hero.css';

const { data } = Astro.props;
---

<section
  class="page-head"
  data-screen-label="Services · Header"
>
  <div class="crumb">
    <a href="/">
      <span>QuickAppend</span>
    </a>

    <span>/</span>

    <b>{data?.eyebrow}</b>
  </div>

  <h1 class="h1">
    {data?.heading}

    {data?.headingHighlight && (
      <em>{data.headingHighlight}</em>
    )}
  </h1>

  <p class="lede">
    {data?.description}
  </p>

  <div class="hero-actions">
    <button
      class="btn btn-hot"
      data-open-modal
    >
      {data?.ctaText ?? 'Request free audit'}
    </button>
  </div>

  <div class="head-demo">
    <div id={data?.demoId ?? 'append-demo-mount'}></div>
  </div>
</section>