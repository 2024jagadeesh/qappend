---
import '../../styles/components/services-cta.css';

const { data } = Astro.props;

const variant = data.variant || 'default';
---

<section
  class:list={[
    'svc-cta',
    variant === 'green' && 'svc-cta--green',
  ]}
  data-screen-label={data.screenLabel || 'Services · CTA'}
>
  <div>
    {data.tag && <div class="tag">{data.tag}</div>}

    <h2 class="h2">
      {data.heading}
      {data.headingHighlight && (
        <em>{data.headingHighlight}</em>
      )}
    </h2>

    {data.description && <p>{data.description}</p>}
  </div>

  <div class="svc-cta-actions">
    <button
      class="btn btn-hot"
      data-open-modal
    >
      {data.buttonText}
    </button>
  </div>
</section>