---
import '../../styles/components/appending-enrichment.css';

interface Props {
  data: any;
}

const { data } = Astro.props;
---

<div class="ae-split">

  <section
    class="appending"
    data-screen-label="03 Appending"
  >
    <div class="enrich-hd">
      <div>
        <div class="tag">
          {data?.appendingTag}
        </div>

        <h2 class="h2">
          {data?.appendingHeading}
          <em>{data?.appendingHighlight}</em>
        </h2>
      </div>
    </div>

    <div style="margin-top: 4px;">
      <a
        class="btn btn-hot"
        href={data?.appendingButtonLink || '/services/'}
        style="white-space: nowrap; background-color: #d4a82c;"
      >
        {data?.appendingButtonText}
      </a>
    </div>
  </section>


  <section
    class="enrich"
    id="enrich"
    data-screen-label="04 Enrichment"
  >
    <div class="enrich-hd">
      <div>
        <div class="tag">
          {data?.enrichmentTag}
        </div>

        <h2 class="h2">
          {data?.enrichmentHeading}
          <em>{data?.enrichmentHighlight}</em>
        </h2>
      </div>
    </div>

    <div style="margin-top: 4px;">
      <a
        class="btn btn-hot"
        href={data?.enrichmentButtonLink || '/enrichment/'}
        style="white-space: nowrap;"
      >
        {data?.enrichmentButtonText}
      </a>
    </div>
  </section>

</div>

<!-- APPENDING + ENRICHMENT (side by side) -->
<style>
  .ae-split { display: flex; align-items: stretch; gap: 0; }
  .ae-split > section { flex: 1 1 0; min-width: 0; padding-top: clamp(40px, 4vw, 60px); padding-bottom: clamp(40px, 4vw, 60px); padding-left: clamp(32px, 3.4vw, 64px); padding-right: clamp(32px, 3.4vw, 64px); position: relative; transition: transform .32s cubic-bezier(.22,.61,.36,1), box-shadow .32s; }
  .ae-split > .appending { transform-origin: left center; }
  .ae-split > .enrich { transform-origin: right center; }
  .ae-split > section:hover { transform: translateY(-10px) scale(1.035); z-index: 5; box-shadow: 0 40px 80px -30px rgba(0,0,0,.55); }
  .ae-split .enrich-hd { grid-template-columns: 1fr; gap: 18px; align-items: start; margin-bottom: 28px; }
  .ae-split .enrich-hd h2 { font-size: clamp(28px, 3vw, 40px); }
  @media (max-width: 980px) {
    .ae-split { flex-direction: column; }
    .ae-split > .appending { border-radius: 36px 36px 0 0 !important; }
    .ae-split > .enrich { border-radius: 0 0 36px 36px !important; }
  }
</style>