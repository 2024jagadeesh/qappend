---
const { data } = Astro.props;
---

<section
  class="page-head"
  data-screen-label="Process · Header"
>
  <div class="crumb">
    <a href="/">QuickAppend</a>
    <span>/</span>
    <b>{data?.breadcrumbLabel}</b>
  </div>

  <h1 class="h1">
    {data?.heading}
    <em>{data?.headingHighlight}</em>.
  </h1>

  <p class="lede">
    {data?.description}
  </p>

  <div class="hero-actions">
    <button class="btn btn-hot" data-open-modal>
      {data?.ctaText ?? 'Request free audit'}
    </button>
  </div>
</section>