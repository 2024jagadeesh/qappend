---
import '../../styles/shared/footer.css';
import { sanityClient } from '../../lib/sanity';
import { SITE_SETTINGS_QUERY } from '../../lib/queries';

const settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);

const footer = settings?.footer;

const footerColumns = footer?.columns || [];
const legalLinks = footer?.legalLinks || [];
---

<footer>

  <div class="ft-top">

    <!-- BRAND -->
    <div class="ft-brand">

      <a
        class="logo"
        href="/"
        style="color: var(--paper);"
      >
        <span class="logo-mark"></span>

        <span>
          {settings?.siteName ?? 'QuickAppend'}
        </span>
      </a>

      <p>
        {footer?.description ||
          'Helping B2B revenue teams improve data quality, customer intelligence, and go-to-market precision through scalable appending and enrichment.'}
      </p>

    </div>


    <!-- FOOTER COLUMNS -->
    {
      footerColumns.map((column: any) => (
        <div class="ft-col">

          <h5>
            {column.title}
          </h5>

          <ul>

            {
              column.links?.map((item: any) => (
                <li>
                  <a href={item.link || '#'}>
                    {item.label}
                  </a>
                </li>
              ))
            }

          </ul>

        </div>
      ))
    }

  </div>


  <!-- LARGE FOOTER MARK -->

  <!--<div class="ft-mark">
    {settings?.siteName?.split(' ')[0] ?? 'Quick'}
    <em>
      {settings?.siteName?.split(' ').slice(1).join(' ') || 'Append'}.
    </em>
  </div> -->


  <!-- BOTTOM -->

  <div class="ft-bottom">

    <div>
      {footer?.copyright ||
        `© ${new Date().getFullYear()} ${settings?.siteName || 'QuickAppend'}, Inc. All rights reserved.`}
    </div>


    <div class="ft-legal">

      {
        legalLinks.map((item: any) => (
          <a href={item.link || '#'}>
            {item.label}
          </a>
        ))
      }

    </div>


    <div>
      {footer?.bottomText || 'Made for revenue teams who count.'}
    </div>

  </div>

</footer>