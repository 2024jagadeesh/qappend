---
import '../../styles/shared/header.css';
import { sanityClient } from '../../lib/sanity';
import { SITE_SETTINGS_QUERY } from '../../lib/queries';

const settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);

const navigation = settings?.navigation || [];
const currentPath = Astro.url.pathname;
---

<nav class="nav">

  <!-- Logo -->
  <a class="logo" href="/">
    {settings?.logoUrl ? (
      <img
        src={settings.logoUrl}
        alt={settings.siteName ?? 'QuickAppend'}
      />
    ) : (
      <>
        <span class="logo-mark"></span>
        <span>{settings?.siteName ?? 'QuickAppend'}</span>
      </>
    )}
  </a>


  <!-- Navigation -->
  <ul class="nav-links">

    {navigation.map((item: any) => {

      /* ================================
         DROPDOWN
      ================================= */
      if (item.type === 'dropdown') {
        return (
          <li class="nav-item">

            <button
              type="button"
              class="nav-trigger"
              aria-haspopup="true"
            >
              {item.label}
            </button>

            <div
              class:list={[
                'nav-menu',
                item.dropdownStyle === 'right' && 'nav-menu--right'
              ]}
            >
              <div class="nav-menu-inner">

                {item.items?.map((subItem: any) => (
                  <a
                    href={subItem.link || '#'}
                    class:list={[
                      currentPath === subItem.link && 'active'
                    ]}
                  >
                    <span>{subItem.label}</span>

                    {subItem.description && (
                      <small>
                        {subItem.description}
                      </small>
                    )}
                  </a>
                ))}

              </div>
            </div>

          </li>
        );
      }


      /* ================================
         NORMAL LINK
      ================================= */
      return (
        <li>
          <a
            href={item.link || '#'}
            class:list={[
              currentPath === item.link && 'active'
            ]}
          >
            {item.label}
          </a>
        </li>
      );

    })}

  </ul>


  <!-- CTA -->
  <button
    class="nav-cta"
    type="button"
    data-open-modal
  >
    {settings?.headerCtaText ?? 'Request Audit'}
  </button>

</nav>