---
import '../../styles/components/header.css';
import { sanityClient } from '../../lib/sanity';
import { SITE_SETTINGS_QUERY } from '../../lib/queries';

const settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);
---

<nav class="nav">

  <!-- Logo -->
  <a class="logo" href="/">
    {settings?.logoUrl ? (
      <img
        src={settings.logoUrl}
        alt={settings.siteName ?? 'QuickAppend'}
      />
    ) : (
      <>
        <span class="logo-mark"></span>
        <span>{settings?.siteName ?? 'QuickAppend'}</span>
      </>
    )}
  </a>


  <!-- Navigation -->
  <ul class="nav-links">

    <!-- Services -->
    <li class="nav-item">

      <button
        type="button"
        class="nav-trigger"
        aria-haspopup="true"
      >
        Services
      </button>

      <div class="nav-menu">
        <div class="nav-menu-inner">

          <a href="/services/">
            <span>Append</span>
            <small>Complete the record, field by field</small>
          </a>

          <a href="/enrichment/">
            <span>Enrichment</span>
            <small>Turn records into intelligence</small>
          </a>

        </div>
      </div>

    </li>


    <!-- Process -->
    <li>
      <a href="/process/">
        Process
      </a>
    </li>


    <!-- Use Cases -->
    <li>
      <a href="/use-cases/">
        Use Cases
      </a>
    </li>


    <!-- Company -->
    <li class="nav-item">

      <button
        type="button"
        class="nav-trigger"
        aria-haspopup="true"
      >
        Company
      </button>

      <div class="nav-menu nav-menu--right">
        <div class="nav-menu-inner">

          <a href="/about/">
            <span>About</span>
            <small>Who we are</small>
          </a>

          <a href="/contact/">
            <span>Contact</span>
            <small>Talk to a specialist</small>
          </a>

          <a href="/case-studies/">
            <span>Case Studies</span>
            <small>Results in the field</small>
          </a>

          <a href="/blog/">
            <span>Blogs</span>
            <small>Guides &amp; insights</small>
          </a>

          <a href="/whitepapers/">
            <span>White Papers</span>
            <small>In-depth playbooks</small>
          </a>

          <a href="/faq/">
            <span>FAQ</span>
            <small>Common questions</small>
          </a>

        </div>
      </div>

    </li>

  </ul>


  <!-- CTA -->
  <button
    class="nav-cta"
    type="button"
    data-open-modal
  >
    {settings?.headerCtaText ?? 'Request Audit'}
  </button>

</nav>