---
import Layout from '../../layouts/MainLayout.astro';
import { sanityClient } from '../../lib/sanity';

export async function getStaticPaths() {
  const whitepapers = await sanityClient.fetch(`
    *[_type == "whitepaper" && defined(slug.current)] {
      "slug": slug.current
    }
  `);

  return whitepapers.map((whitepaper: any) => ({
    params: {
      slug: whitepaper.slug,
    },
  }));
}


/* =========================================================
   CURRENT WHITE PAPER
   ========================================================= */

const { slug } = Astro.params;

const whitepaper = await sanityClient.fetch(
  `
    *[_type == "whitepaper" && slug.current == $slug][0] {
      _id,
      title,
      slug,
      category,
      description,
      readTime,
      featured,
      publishedAt,

      hero {
        badge,
        title,
        description,

        heroImage {
          asset-> {
            url
          },
          alt
        },

        primaryButton {
          text,
          link
        },

        secondaryButton {
          text,
          link
        }
      },

      problem {
        eyebrow,
        heading,
        description,

        checklist[] {
          text
        },

        stats[] {
          number,
          label,
          description
        }
      },

      offering {
        eyebrow,
        heading,
        description,

        cards[] {
          title,
          description,
          icon
        }
      },

      proof {
        eyebrow,
        heading,
        description,

        metrics[] {
          value,
          label,
          description
        },

        chart {
          title,
          firstLabel,
          secondLabel,

          items[] {
            label,
            firstValue,
            secondValue
          },

          note
        }
      },

      process {
        eyebrow,
        heading,
        description,

        steps[] {
          number,
          label,
          title,
          description
        },

        note
      },

      output {
        eyebrow,
        heading,
        description,

        image {
          asset-> {
            url
          },
          alt
        },

        note
      },

      trust {
        eyebrow,
        heading,
        description,

        items[] {
          title,
          description,
          icon
        }
      },

      cta {
        eyebrow,
        heading,
        description,

        cards[] {
          title,
          description,
          buttonText,
          buttonAction,
          buttonLink
        }
      }
    }
  `,
  { slug }
);

if (!whitepaper) {
  return Astro.redirect('/404');
}


/* =========================================================
   HELPERS
   ========================================================= */

const hero = whitepaper.hero;
const problem = whitepaper.problem;
const offering = whitepaper.offering;
const proof = whitepaper.proof;
const process = whitepaper.process;
const output = whitepaper.output;
const trust = whitepaper.trust;
const cta = whitepaper.cta;


/* =========================================================
   ICON
   ========================================================= */

const getIcon = (icon: string | undefined) => {
  switch (icon) {
    case 'phone':
      return `
        <svg viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2
            19.79 19.79 0 0 1-8.63-3.07
            19.5 19.5 0 0 1-6-6
            19.79 19.79 0 0 1-3.07-8.67
            A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2
            1.72c.13.96.36 1.9.7 2.81
            a2 2 0 0 1-.45 2.11L8.09 9.91
            a16 16 0 0 0 6 6l1.27-1.27
            a2 2 0 0 1 2.11-.45c.9.34
            1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
      `;

    case 'email':
      return `
        <svg viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94
            0 0 1-2.06 0L2 7"/>
        </svg>
      `;

    case 'database':
      return `
        <svg viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <ellipse cx="12" cy="5" rx="9" ry="3"/>
          <path d="M3 5v14a9 3 0 0 0 18 0V5"/>
          <path d="M3 12a9 3 0 0 0 18 0"/>
        </svg>
      `;

    case 'shield':
      return `
        <svg viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7
            c0 6 8 10 8 10z"/>
        </svg>
      `;

    case 'bolt':
      return `
        <svg viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 2 3 14h9l-1 8
            10-12h-9l1-8z"/>
        </svg>
      `;

    case 'refresh':
      return `
        <svg viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 1 1-3-6.7L21 8"/>
          <path d="M21 3v5h-5"/>
        </svg>
      `;

    case 'lock':
      return `
        <svg viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      `;

    default:
      return `
        <svg viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 8v4l3 2"/>
        </svg>
      `;
  }
};
---

<Layout title={`${whitepaper.title} · QuickAppend`}>

  <div class="wp-wrap">

    <!-- =====================================================
         HERO
         ====================================================== -->

    <section class="wp-hero">

      <div class="wp-hero-inner">

        {
          hero?.badge && (
            <span class="wp-badge">
              {hero.badge}
            </span>
          )
        }

        <h1>
          {hero?.title || whitepaper.title}
        </h1>

        <p>
          {hero?.description || whitepaper.description}
        </p>

        <div class="wp-hero-actions">

          {
            hero?.primaryButton?.text && (
              <a
                class="btn btn-hot"
                href={hero.primaryButton.link || '/contact'}
              >
                {hero.primaryButton.text}
              </a>
            )
          }

          {
            hero?.secondaryButton?.text && (
              <a
                class="btn btn-ghost"
                href={hero.secondaryButton.link || '/contact'}
              >
                {hero.secondaryButton.text}
              </a>
            )
          }

        </div>

      </div>

    </section>


    <!-- =====================================================
         HERO IMAGE
         ====================================================== -->

    {
      hero?.heroImage?.asset?.url && (
        <section class="wp-heroimg-sec">

          <figure class="wp-heroimg">

            <img
              src={hero.heroImage.asset.url}
              alt={hero.heroImage.alt || whitepaper.title}
            />

          </figure>

        </section>
      )
    }


    <!-- =====================================================
         PROBLEM / DATA DECAY
         ====================================================== -->

    {
      problem && (
        <section class="wp-sec">

          <div class="wp-split">

            <div>

              {
                problem.eyebrow && (
                  <div class="wp-eyebrow">
                    {problem.eyebrow}
                  </div>
                )
              }

              <h2 class="wp-h2">
                {problem.heading}
              </h2>

              {
                problem.description && (
                  <p class="wp-lede">
                    {problem.description}
                  </p>
                )
              }

              {
                problem.checklist?.length > 0 && (
                  <div class="wp-checklist">

                    {
                      problem.checklist.map((item: any) => (
                        <div class="wp-check-item">

                          <span class="wp-check-mark">
                            ✓
                          </span>

                          <p>
                            {item.text}
                          </p>

                        </div>
                      ))
                    }

                  </div>
                )
              }

            </div>


            {
              problem.stats?.length > 0 && (
                <div class="wp-statstack">

                  {
                    problem.stats.map((stat: any, index: number) => (

                      <div
                        class="wp-statcard"
                        class:list={{
                          second: index === 1,
                        }}
                      >

                        <span class="num">
                          {stat.number}
                        </span>

                        <span class="lbl">
                          {stat.label}
                        </span>

                        {
                          stat.description && (
                            <span class="sub">
                              {stat.description}
                            </span>
                          )
                        }

                      </div>

                    ))
                  }

                </div>
              )
            }

          </div>

        </section>
      )
    }


    <!-- =====================================================
         OFFERING
         ====================================================== -->

    {
      offering && (
        <section class="wp-alt">

          <div class="wp-sec">

            {
              offering.eyebrow && (
                <div class="wp-eyebrow">
                  {offering.eyebrow}
                </div>
              )
            }

            <h2 class="wp-h2">
              {offering.heading}
            </h2>

            {
              offering.description && (
                <p class="wp-lede">
                  {offering.description}
                </p>
              )
            }


            {
              offering.cards?.length > 0 && (
                <div class="wp-cards">

                  {
                    offering.cards.map((card: any) => (

                      <div class="wp-card">

                        <div class="wp-card-ic"
                          set:html={getIcon(card.icon)}
                        />

                        <h3>
                          {card.title}
                        </h3>

                        <p>
                          {card.description}
                        </p>

                      </div>

                    ))
                  }

                </div>
              )
            }

          </div>

        </section>
      )
    }


    <!-- =====================================================
         PROOF / METRICS
         ====================================================== -->

    {
      proof && (
        <section class="wp-sec">

          {
            proof.eyebrow && (
              <div class="wp-eyebrow">
                {proof.eyebrow}
              </div>
            )
          }

          <h2 class="wp-h2">
            {proof.heading}
          </h2>

          {
            proof.description && (
              <p class="wp-lede">
                {proof.description}
              </p>
            )
          }


          <!-- METRICS -->

          {
            proof.metrics?.length > 0 && (
              <div class="wp-metrics">

                {
                  proof.metrics.map((metric: any) => (

                    <div class="wp-metric">

                      <div class="num">
                        {metric.value}
                      </div>

                      <div class="lbl">
                        {metric.label}
                      </div>

                      {
                        metric.description && (
                          <div class="sub">
                            {metric.description}
                          </div>
                        )
                      }

                    </div>

                  ))
                }

              </div>
            )
          }


          <!-- CHART -->

          {
            proof.chart?.items?.length > 0 && (

              <div class="wp-chart">

                <div class="wp-chart-hd">

                  <div class="wp-chart-title">
                    {proof.chart.title}
                  </div>

                  <div class="wp-legend">

                    <span class="wp-leg wp-leg--qa">
                      {proof.chart.firstLabel}
                    </span>

                    <span class="wp-leg wp-leg--ind">
                      {proof.chart.secondLabel}
                    </span>

                  </div>

                </div>


                <div class="wp-plot">

                  <div class="wp-gridlines">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>


                  <div class="wp-groups">

                    {
                      proof.chart.items.map((item: any) => {

                        const first =
                          Number.parseFloat(
                            String(item.firstValue).replace('%', '')
                          ) || 0;

                        const second =
                          Number.parseFloat(
                            String(item.secondValue).replace('%', '')
                          ) || 0;

                        return (

                          <div class="wp-group">

                            <div class="wp-bars">

                              <div
                                class="wp-bar wp-bar--qa"
                                style={`height: ${first}%;`}
                              >
                                <span class="wp-bar-val">
                                  {item.firstValue}
                                </span>
                              </div>

                              <div
                                class="wp-bar wp-bar--ind"
                                style={`height: ${second}%;`}
                              >
                                <span class="wp-bar-val">
                                  {item.secondValue}
                                </span>
                              </div>

                            </div>

                            <div class="wp-group-lbl">
                              {item.label}
                            </div>

                          </div>

                        );

                      })
                    }

                  </div>

                </div>

              </div>
            )
          }


          {
            proof.chart?.note && (
              <p class="wp-note wp-metrics-note">
                {proof.chart.note}
              </p>
            )
          }

        </section>
      )
    }


    <!-- =====================================================
         PROCESS
         ====================================================== -->

    {
      process && (
        <section class="wp-alt">

          <div class="wp-sec">

            {
              process.eyebrow && (
                <div class="wp-eyebrow">
                  {process.eyebrow}
                </div>
              )
            }

            <h2 class="wp-h2">
              {process.heading}
            </h2>

            {
              process.description && (
                <p class="wp-lede">
                  {process.description}
                </p>
              )
            }


            {
              process.steps?.length > 0 && (
                <div class="wp-flow">

                  {
                    process.steps.map((step: any, index: number) => (

                      <div class="wp-step">

                        <span class="n">
                          {step.number || index + 1}
                        </span>

                        {
                          step.label && (
                            <div class="tick">
                              {step.label}
                            </div>
                          )
                        }

                        <h4>
                          {step.title}
                        </h4>

                        <p>
                          {step.description}
                        </p>

                      </div>

                    ))
                  }

                </div>
              )
            }


            {
              process.note && (
                <p class="wp-note wp-flow-note">
                  {process.note}
                </p>
              )
            }

          </div>

        </section>
      )
    }


    <!-- =====================================================
         OUTPUT
         ====================================================== -->

    {
      output && (
        <section class="wp-sec">

          {
            output.eyebrow && (
              <div class="wp-eyebrow">
                {output.eyebrow}
              </div>
            )
          }

          <h2 class="wp-h2">
            {output.heading}
          </h2>

          {
            output.description && (
              <p class="wp-lede">
                {output.description}
              </p>
            )
          }


          {
            output.image?.asset?.url && (
              <figure class="wp-fields-img">

                <img
                  src={output.image.asset.url}
                  alt={output.image.alt || output.heading}
                />

              </figure>
            )
          }


          {
            output.note && (
              <p class="wp-note wp-fields-note">
                {output.note}
              </p>
            )
          }

        </section>
      )
    }


    <!-- =====================================================
         TRUST / WHY TEAMS CHOOSE US
         ====================================================== -->

    {
      trust && (
        <section class="wp-sec">

          {
            trust.eyebrow && (
              <div class="wp-eyebrow">
                {trust.eyebrow}
              </div>
            )
          }

          <h2 class="wp-h2">
            {trust.heading}
          </h2>

          {
            trust.description && (
              <p class="wp-lede">
                {trust.description}
              </p>
            )
          }


          {
            trust.items?.length > 0 && (
              <div class="wp-trust-grid">

                {
                  trust.items.map((item: any) => (

                    <div class="wp-trust-box">

                      <div
                        class="wp-trust-ic"
                        set:html={getIcon(item.icon)}
                      />

                      <h5>
                        {item.title}
                      </h5>

                      <p>
                        {item.description}
                      </p>

                    </div>

                  ))
                }

              </div>
            )
          }

        </section>
      )
    }


    <!-- =====================================================
         FINAL CTA
         ====================================================== -->

    {
      cta && (
        <section class="wp-cta">

          <div class="wp-sec">

            {
              cta.eyebrow && (
                <div
                  class="wp-eyebrow"
                  style="color:#d4a82c;"
                >
                  {cta.eyebrow}
                </div>
              )
            }

            <h2 class="wp-h2">
              {cta.heading}
            </h2>

            {
              cta.description && (
                <p class="wp-lede">
                  {cta.description}
                </p>
              )
            }


            {
              cta.cards?.length > 0 && (

                <div class="wp-cta-grid">

                  {
                    cta.cards.map((card: any, index: number) => (

                      <div
                        class:list={{
                          'wp-cta-card': true,
                          gold: index === 1,
                        }}
                      >

                        <h3>
                          {card.title}
                        </h3>

                        <p>
                          {card.description}
                        </p>


                        {
                          card.buttonText && (
                            <a
                              class:list={{
                                btn: index === 0,
                                'btn-hot': index === 0,
                                'btn-dark': index === 1,
                              }}
                              href={
                                card.buttonLink ||
                                card.buttonAction ||
                                '/contact'
                              }
                            >
                              {card.buttonText}
                            </a>
                          )
                        }

                      </div>

                    ))
                  }

                </div>

              )
            }

          </div>

        </section>
      )
    }

  </div>

</Layout>


<style>

/* =========================================================
   WHITE PAPER
   ========================================================= */

.wp-wrap {
  background: var(--paper);
}

.wp-sec {
  max-width: 1080px;
  margin: 0 auto;
  padding: clamp(52px, 6vw, 80px) var(--pad-x);
}

.wp-eyebrow {
  font-family: var(--f-mono);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--hot);
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 22px;
}

.wp-eyebrow::before {
  content: "";
  width: 24px;
  height: 1px;
  background: var(--hot);
}

.wp-h2 {
  font-family: var(--f-display);
  font-size: clamp(30px, 4vw, 52px);
  font-weight: 600;
  letter-spacing: -.035em;
  line-height: 1.04;
  color: var(--ink);
  text-wrap: balance;
  max-width: 20ch;
}

.wp-h2 em {
  font-family: var(--f-serif);
  font-style: italic;
  font-weight: 400;
  color: var(--hot);
}

.wp-lede {
  font-size: 19px;
  line-height: 1.6;
  color: var(--ink-2);
  max-width: 62ch;
  margin-top: 20px;
  text-wrap: pretty;
}

.wp-note {
  font-family: var(--f-mono);
  font-size: 12.5px;
  line-height: 1.6;
  color: var(--muted);
  letter-spacing: .01em;
}


/* =========================================================
   HERO
   ========================================================= */

.wp-hero {
  background: #1e2521;
  color: var(--paper);
  padding:
    clamp(120px, 13vw, 168px)
    var(--pad-x)
    clamp(64px, 7vw, 96px);
}

.wp-hero-inner {
  max-width: 1080px;
  margin: 0 auto;
  display: grid;
  gap: 34px;
}

.wp-badge {
  font-family: var(--f-mono);
  font-size: 11.5px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #d4a82c;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  width: fit-content;
  background: rgba(212,168,44,.12);
  border: 1px solid rgba(212,168,44,.32);
  padding: 7px 14px;
  border-radius: 999px;
}

.wp-hero h1 {
  font-family: var(--f-display);
  font-size: clamp(40px, 6.4vw, 84px);
  font-weight: 700;
  letter-spacing: -.04em;
  line-height: .98;
  color: #f4efe6;
  text-wrap: balance;
  max-width: 18ch;
}

.wp-hero h1 em {
  font-family: var(--f-serif);
  font-style: italic;
  font-weight: 400;
  color: #d4a82c;
}

.wp-hero p {
  font-size: clamp(17px, 1.8vw, 21px);
  line-height: 1.6;
  color: color-mix(in srgb, var(--paper) 78%, transparent);
  max-width: 60ch;
}

.wp-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 4px;
}

.wp-hero .btn-hot {
  background: #d4a82c;
  color: #1e2521;
}

.wp-hero .btn-hot:hover {
  background: #e6bd44;
  color: #1e2521;
  transform: translateY(-1px);
}

.wp-hero .btn-ghost {
  color: var(--paper);
  border-color: rgba(255,255,255,.22);
}

.wp-hero .btn-ghost:hover {
  border-color: var(--paper);
  background: rgba(255,255,255,.05);
}


/* =========================================================
   HERO IMAGE
   ========================================================= */

.wp-heroimg-sec {
  max-width: 1080px;
  margin: 0 auto;
  padding:
    clamp(40px, 5vw, 64px)
    var(--pad-x)
    0;
}

.wp-heroimg img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: 22px;
}


/* =========================================================
   PROBLEM + STATS
   ========================================================= */

.wp-split {
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  gap: clamp(36px, 5vw, 72px);
  align-items: center;
}

.wp-checklist {
  display: flex;
  flex-direction: column;
  gap: 18px;
  margin-top: 30px;
}

.wp-check-item {
  display: flex;
  gap: 15px;
  align-items: flex-start;
}

.wp-check-mark {
  flex-shrink: 0;
  width: 24px;
  height: 24px;
  border-radius: 7px;
  margin-top: 2px;
  background: var(--hot);
  color: #fff;
  font-size: 13px;
  font-weight: 700;
  display: grid;
  place-items: center;
}

.wp-check-item p {
  font-size: 17px;
  line-height: 1.55;
  color: var(--ink-2);
  text-wrap: pretty;
}

.wp-check-item p strong {
  color: var(--ink);
  font-weight: 600;
}

.wp-statstack {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.wp-statcard {
  border-radius: 18px;
  padding: 32px 30px;
  background: #1f6b3d;
  color: #fff;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.wp-statcard.second {
  background: #d4a82c;
