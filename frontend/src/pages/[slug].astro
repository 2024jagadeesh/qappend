---
import MainLayout from '../layouts/MainLayout.astro';
import PageRenderer from '../components/shared/PageRenderer.astro';
import { sanityClient } from '../lib/sanity';
import { PAGE_QUERY } from '../lib/queries';

const { slug } = Astro.params;

const page = await sanityClient.fetch(PAGE_QUERY, {
  slug,
});

if (!page) {
  return Astro.redirect('/404');
}
---

<MainLayout
  title={page?.seo?.metaTitle ?? page?.title ?? 'QuickAppend'}
  description={
    page?.seo?.metaDescription ??
    'Data appending and enrichment for B2B revenue teams.'
  }
  canonical={page?.seo?.canonicalUrl}
  ogImage={page?.seo?.ogImage}
  noIndex={page?.seo?.noIndex ?? false}
>
  <PageRenderer sections={page.sections} />
</MainLayout>