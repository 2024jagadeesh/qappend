---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AuditModal from '../components/shared/AuditModal.astro';
import SEO from '../components/shared/SEO.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title = 'QuickAppend',
  description = 'Data appending and enrichment for B2B revenue teams.',
  canonical,
  ogImage,
  noIndex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noIndex={noIndex}
    />
  </head>

  <body>
    <Header />

    <slot />

    <Footer />

    <AuditModal />
  </body>
</html>